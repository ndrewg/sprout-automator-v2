# Dependencies
node_modules/

# Secrets & runtime data
.env
.env.*
!.env.example
data/
app/backend/data/

# Build output
dist/
app/backend/dist/
app/backend/public/

# Logs
*.log

# curl cookie jars from manual API testing — these hold live session ids.
# A file written as `curl -c jar` is named exactly `jar`, which `*.jar` does
# not match (no dot). Widen deliberately: `jar` (bare), `cookie*` (any cookie
# prefix), and `*.cookies` (a cookies-only extension).
*.jar
jar
cookie*
*.cookies
cookies.txt

# Magic Context (opencode) per-project tool state — local, nothing sensitive,
# never commit it. (Was untracked + not ignored during phase 8; added here so a
# blanket `git add` cannot stage its nested .gitignore.)
.cortexkit/

# Test artifacts (Playwright writes these on every run)
test-results/
playwright-report/
.playwright/

# Archived prior build — REFERENCE ONLY, never version-controlled.
# Contains live secrets (.env, Sprout session cookies/storage-state, n8n db +
# encryption key). It stays on disk for reference; it must not enter git.
_archive/

# IDE / OS
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db
