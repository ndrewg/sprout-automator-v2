# Copy to .env and fill in. Never commit the real .env.

# Runtime
NODE_ENV=development
BACKEND_PORT=3000

# PostgreSQL
POSTGRES_USER=sprout
POSTGRES_PASSWORD=sprout_dev_pw
POSTGRES_DB=sprout
POSTGRES_PORT=5432

# App secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace_me_with_64_hex_chars_from_the_command_above_xxxxxxxxxxxxxx

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Optional: native-dev DATABASE_URL (points at the host-mapped Postgres port).
# Docker Compose ignores this and injects its own postgres:5432 URL.
# DATABASE_URL=postgres://sprout:sprout_dev_pw@localhost:5433/sprout

# Optional: public base URL used in emailed links (password reset). Defaults to
# http://localhost:3000 — correct for the Docker build, where Express serves the
# SPA. In the dev loop the SPA is on Vite :5173, so to test a reset locally set
# APP_URL=http://localhost:5173 or the emailed link points at the wrong origin.
# In production (NODE_ENV=production) APP_URL must NOT be localhost or
# 127.0.0.1 — the app refuses to boot otherwise. See DEPLOY.md §4.
# APP_URL=http://localhost:3000

# Optional: signup allowlist (comma-separated domains and exact addresses).
# Required in production — the app refuses to boot without it (see DEPLOY.md).
# SIGNUP_ALLOWED=yourdomain.com, someone@example.com

# Optional: transactional email. Both unset = emails are handled in-process
# (dev: the full message, link included, is logged to the backend console;
# production: recipient + subject only, plus a warning). Set both to actually
# send via Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=Sprout Automator <no-reply@yourdomain.com>

# Optional: auth rate-limit budget (requests per 15 min per IP), shared across
# login, signup, forgot-password and reset. Raise it if a team behind one NAT
# shares an IP and gets locked out by normal password fumbling.
# AUTH_RATE_LIMIT=10

# Optional: missed-run grace (minutes) before a missed scheduled run alerts.
# MISSED_RUN_GRACE_MINUTES=20

# Optional: max concurrent automation runs. Keep 3-4 on the 4 GB VPS; drop to 2
# on a 2 GB box (see DEPLOY.md §2).
# MAX_CONCURRENT_RUNS=3

# --- Rarely changed; defaults are correct for this deployment ---
# The HRHub portal. Change only if your company uses a different Sprout host.
# SPROUT_URL=https://kmcsolutions.hrhub.ph/
# Where run screenshots and browser sessions are written. Compose sets this to
# /app/data inside the container; only override for a native (non-Docker) run.
# DATA_DIR=./data
# Port the backend listens on inside the container. Compose maps it via
# BACKEND_PORT above; you almost never change this one.
# PORT=3000
