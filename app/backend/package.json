{
  "name": "sprout-automator-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "date-holidays": "^3.37.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.2",
    "mailparser": "^3.9.38",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "playwright": "1.60.0",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
